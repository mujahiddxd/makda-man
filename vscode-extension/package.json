{
  "name": "depexit",
  "displayName": "DepExit \u2014 Dependency Resilience",
  "description": "Inline dependency-risk diagnostics, Gemma 4 migration proposals and one-click migrated files from a DepExit Exit Capsule.",
  "version": "0.1.0",
  "publisher": "depexit",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Linters",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onUri"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "depexit.signIn",
        "title": "DepExit: Sign in with GitHub"
      },
      {
        "command": "depexit.signOut",
        "title": "DepExit: Sign Out"
      },
      {
        "command": "depexit.analyze",
        "title": "DepExit: Analyze This Workspace"
      },
      {
        "command": "depexit.clone",
        "title": "DepExit: Clone Analysed Repository & Open"
      },
      {
        "command": "depexit.load",
        "title": "DepExit: Load Analysis by ID"
      },
      {
        "command": "depexit.openCapsule",
        "title": "DepExit: Open Exit Capsule (Markdown)"
      },
      {
        "command": "depexit.openPatch",
        "title": "DepExit: Open Migration Patch"
      },
      {
        "command": "depexit.applyAll",
        "title": "DepExit: Apply All Migrations"
      },
      {
        "command": "depexit.clear",
        "title": "DepExit: Clear Diagnostics"
      }
    ],
    "configuration": {
      "title": "DepExit",
      "properties": {
        "depexit.apiUrl": {
          "type": "string",
          "default": "http://localhost:8080",
          "description": "DepExit API base URL."
        },
        "depexit.minLevel": {
          "type": "string",
          "enum": [
            "critical",
            "high",
            "medium",
            "low"
          ],
          "default": "medium",
          "description": "Only show diagnostics for dependencies at or above this risk level."
        }
      }
    }
  }
}
