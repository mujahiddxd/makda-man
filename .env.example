# shared
DATA_DIR=./data
# Go API
# Sign in with GitHub (optional). Create an OAuth App at https://github.com/settings/developers with the callback
# URL http://localhost:8080/api/auth/github/callback, then fill these in. JWT_SECRET signs sessions: set your own.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# GITHUB_REDIRECT_URI=http://localhost:8080/api/auth/github/callback
# FRONTEND_URL=http://localhost:3000
# JWT_SECRET=
# Email/password accounts (optional): a Neon (or any) PostgreSQL connection string. Without it only GitHub sign-in works.
# DATABASE_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
PORT=8080
AI_SERVICE_URL=http://localhost:8001
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
SANDBOX_IMAGE=python:3.12-slim
SANDBOX_TIMEOUT_S=900
# pip download cache shared by all sandbox installs (a Docker volume; packages download once). off = disable
SANDBOX_PIP_CACHE=depexit-pip-cache
# Optional PyPI mirror when pypi.org is slow from your network, e.g. https://pypi.tuna.tsinghua.edu.cn/simple
# PIP_INDEX_URL=
DEFAULT_REPO_URL=https://github.com/rishrek/LinkWatch
# AI service
# Comma-separated Google AI Studio keys; the next key is used automatically when one is exhausted/rejected.
GEMINI_API_KEYS=
# Tried in order; the next model is used when one is overloaded.
GEMMA_MODELS=gemma-4-31b-it,gemma-4-26b-a4b-it
GEMMA_TIMEOUT_S=120
GEMMA_MAX_CONCURRENCY=6
# Fallback LLM (xAI Grok), used only when every Gemma key/model fails. Comma-separated.
XAI_API_KEYS=
XAI_MODEL=
GEMMA_CACHE=1
GEMMA_HEDGE_AFTER_S=15
# Non-Gemma Gemini models, used only when Gemma 4 fails or misses its time budget (disclosed in the capsule)
FALLBACK_MODELS=gemini-3.5-flash,gemini-3.1-flash-lite
GEMMA_BUDGET_SHARE=0.3
# Share of the remaining time the Gemini fallback gets before Groq takes over
GEMINI_BUDGET_SHARE=0.5
# Fallback (Groq, OpenAI-compatible), after Gemini and before xAI. Comma-separated.
GROQ_API_KEYS=
GROQ_MODEL=openai/gpt-oss-120b
# Demo pacing: seconds each analysis stage stays visibly "running" before it works (0 = off; Docker stages are never paced)
DEMO_STAGE_DELAY_S=0
